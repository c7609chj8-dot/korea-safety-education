# Canonical production origin. Keep the root HTTPS URL without a path or query.
SITE_URL=https://korea-safety-education.vercel.app

# Public verification value issued by Google Search Console (content value only).
# Leave empty until issued. This is not an account password or an API key.
GOOGLE_SITE_VERIFICATION=

# VERCEL_ENV is provided by Vercel. Do not manually set it in deployed environments.
# Production is indexable; preview, development and local builds are noindex.
